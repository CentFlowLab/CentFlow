{
  "expo": {
    "name": "CentFlow",
    "slug": "centflow",
    "version": "0.1.0",
    "scheme": "centflow",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.centflow.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.centflow.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#4B45E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "CentFlow",
      "shortName": "CentFlow",
      "description": "O teu dinheiro, sob controlo.",
      "themeColor": "#4B45E6",
      "backgroundColor": "#F7F7F9"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4014cf35-c2eb-4976-a1ce-5f6bb985652b"
      }
    },
    "owner": "manuc98"
  }
}
