# Copiar para .env.local e preencher com o projeto de produção.
# Para staging, usar .env.staging.example. Nunca a chave secret/service_role.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: Sign in with Apple na web (exige o fornecedor Apple configurado no dashboard).
# EXPO_PUBLIC_AUTH_APPLE_ENABLED=true

# Auth proposta em supabase/config.toml. Não pôr a chave da API neste ficheiro versionado.
# CENTFLOW_AUTH_SITE_URL=https://origem-da-pwa
# CENTFLOW_PWA_AUTH_CALLBACK=https://origem-da-pwa/auth/callback
# CENTFLOW_PWA_AUTH_RESET=https://origem-da-pwa/auth/reset-password
# RESEND_FROM_EMAIL=noreply@dominio-verificado
# RESEND_API_KEY= fica só num .env ignorado pelo git, ou no painel. Nunca no repositório.
