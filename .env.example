# Copiar para .env.local e preencher. Só a chave publicável do Supabase; nunca a secret/service_role.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: Sign in with Apple na web (exige o fornecedor Apple configurado no dashboard).
# EXPO_PUBLIC_AUTH_APPLE_ENABLED=true
