# URL da API CentFlow (legacy REST — usado quando Supabase não está activo)
#
# IMPORTANTE para iPhone/dispositivo físico:
# - localhost NÃO funciona no telemóvel
# - Usa o IP do teu PC na mesma Wi‑Fi, ex:
#   EXPO_PUBLIC_API_URL=http://192.168.1.72:3000
#
# Produção legacy:
# EXPO_PUBLIC_API_URL=https://api.centflow.app

EXPO_PUBLIC_API_URL=https://api.centflow.app

# -----------------------------------------------------------------------------
# Supabase (backend principal quando mock está desligado)
# Dashboard: https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------

# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Login com Google (Supabase Auth + expo-auth-session)
# -----------------------------------------------------------------------------
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
#    - Tipo "Web application" para o Supabase
#    - Authorized redirect URI: https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 2. Supabase Dashboard → Authentication → Providers → Google (activar + colar Client ID/Secret)
# 3. Supabase → Authentication → URL Configuration → Redirect URLs:
#    - centflow://auth/callback
#    - centflow://**
#    - exp://**  (Expo Go / dev client)
# 4. Produção EAS: EXPO_PUBLIC_MOCK_AUTH=false + variáveis Supabase no perfil production
# 5. Android (opcional): adicionar SHA-1 do keystore EAS no Google Cloud (tipo Android client)

# -----------------------------------------------------------------------------
# Variante da app (build EAS)
# -----------------------------------------------------------------------------

# development | beta | production — definido automaticamente em eas.json
# EXPO_PUBLIC_APP_VARIANT=development

# -----------------------------------------------------------------------------
# Modo desenvolvimento (apenas variant=development)
# -----------------------------------------------------------------------------

# Login/registo + movimentos em memória (sem backend)
# Activo por defeito em __DEV__ com variant=development
# EXPO_PUBLIC_MOCK_AUTH=true

# Força dados de demonstração no ecrã Início (ignorado em beta/production)
# EXPO_PUBLIC_USE_MOCK=true

# Dados OCR fictícios (Continente demo) — só para demos em dev
# EXPO_PUBLIC_MOCK_OCR=true

# Saltar gate de onboarding em desenvolvimento (acesso directo às tabs/settings)
# EXPO_PUBLIC_SKIP_ONBOARDING=true

# Preferências de utilizador: em modo mock guardam-se localmente (SecureStore).
# Com Supabase activo, aplicar migration 20240616000000_user_preferences.sql

# -----------------------------------------------------------------------------
# Builds e OTA — ver docs/build.md
# Fluxo principal: EAS Build + EAS Update (npm run eas:build:preview:ios)
# Alternativa legacy: GitHub Actions → IPA unsigned (LiveContainer)
# -----------------------------------------------------------------------------

# Edge Function process-receipt (secrets no Supabase Dashboard, não na app):
# supabase secrets set GOOGLE_VISION_API_KEY=<google-cloud-api-key>
# SUPABASE_SERVICE_ROLE_KEY — injectado automaticamente no deploy
