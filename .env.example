# Copiar para .env.local e preencher com o projeto de produção.
# Para staging, usar .env.staging.example. Nunca a chave secret/service_role.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: Sign in with Apple na web (exige o fornecedor Apple configurado no dashboard).
# EXPO_PUBLIC_AUTH_APPLE_ENABLED=true

# Auth proposta em supabase/config.toml, com origem https://miven.pt.
# Não pôr a chave da API neste ficheiro versionado.
# RESEND_FROM_EMAIL=noreply@miven.pt
# RESEND_API_KEY= fica só num .env ignorado pelo git, ou no painel. Nunca no repositório.

# Sentry. A DSN é a chave pública do cliente. O token de upload de source maps não entra no git.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_AUTH_TOKEN= fica só num .env ignorado pelo git, ou como segredo do EAS.
