# URL da API CentFlow
#
# IMPORTANTE para iPhone/dispositivo físico:
# - localhost NÃO funciona no telemóvel
# - Usa o IP do teu PC na mesma Wi‑Fi, ex:
#   EXPO_PUBLIC_API_URL=http://192.168.1.72:3000
#
# Produção:
# EXPO_PUBLIC_API_URL=https://api.centflow.app

EXPO_PUBLIC_API_URL=https://api.centflow.app

# Modo desenvolvimento: login/registo + movimentos em memória (sem backend)
# Activo por defeito em __DEV__. Para forçar API real: EXPO_PUBLIC_MOCK_AUTH=false
# EXPO_PUBLIC_MOCK_AUTH=true
# Dados OCR fictícios (Continente demo) — só para demos: EXPO_PUBLIC_MOCK_OCR=true
