    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "~19.2.2",
    "eas-cli": "^20.1.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "handoff": "tsx scripts/generate-handoff.ts",
    "test": "tsx --test lib/**/*.test.ts",
    "test:ocr": "tsx scripts/test-ocr-sanitize.ts",
    "supabase:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "eas:init": "eas init",
    "eas:build:dev:ios": "node scripts/eas-run.cjs build --profile development --platform ios",
    "eas:build:dev:android": "node scripts/eas-run.cjs build --profile development --platform android",
    "eas:build:beta:ios": "node scripts/eas-run.cjs build --profile beta --platform ios",
    "eas:build:beta:android": "node scripts/eas-run.cjs build --profile beta --platform android",
    "eas:build:preview:ios": "node scripts/eas-run.cjs build --profile beta --platform ios",
    "eas:build:preview:android": "node scripts/eas-run.cjs build --profile beta --platform android",
    "eas:build:preview-real:android": "node scripts/eas-run.cjs build --profile preview-real --platform android",
    "eas:build:preview-simulator:ios": "node scripts/eas-run.cjs build --profile preview-simulator --platform ios",
    "eas:build:production:ios": "node scripts/eas-run.cjs build --profile production --platform ios",
    "eas:build:production:android": "node scripts/eas-run.cjs build --profile production --platform android",
    "eas:update:preview": "node scripts/eas-run.cjs update --channel preview --environment preview --message",
    "eas:update:production": "node scripts/eas-run.cjs update --channel production --environment production --message",
    "eas:update:list": "node scripts/eas-run.cjs update:list"
  },
  "private": true
}
