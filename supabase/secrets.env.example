# Copia para secrets.env e preenche (secrets.env está no .gitignore).
# Depois: npm run email:setup
#
# Resend: https://resend.com/api-keys

# Obrigatório — API key Resend (re_...)
RESEND_API_KEY=re_COLOCA_AQUI

# Modo: sandbox (teste, só para o teu email Resend) | production (domínio verificado)
EMAIL_MODE=sandbox

# Remetente — ignorado se EMAIL_MODE=sandbox (usa onboarding@resend.dev)
# Produção (após verificar mail.centflow.app no Resend):
# EMAIL_FROM=CentFlow <noreply@mail.centflow.app>
EMAIL_FROM=CentFlow <noreply@mail.centflow.app>

# Gerado automaticamente por npm run email:setup se vazio
EMAIL_CRON_SECRET=

# GoCardless Bank Account Data (Open Banking) — https://bankaccountdata.gocardless.com/
# Cria user secret em: Bank Account Data portal → User secrets
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
