{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "web-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.EXPO_PUBLIC_SUPABASE_URL='';process.env.EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY='';process.env.EXPO_NO_DOTENV='1';require('child_process').spawn('npx',['expo','start','--web','--port','8083'],{stdio:'inherit',shell:true,env:process.env})"
      ],
      "port": 8083
    }
  ]
}
